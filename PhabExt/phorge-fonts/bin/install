#!/bin/sh
# Copyright (C) 2026 Hong Yongmin <https://revi.xyz/>
# SPDX-License-Identifier: Apache-2.0
#
# Copies this extension into a Phorge install, downloads its fonts, and
# rebuilds the Celerity resource map.
#
#   sh bin/install [PHORGE_ROOT]
#
# PHORGE_ROOT defaults to $PHORGE, then to /var/www/phorge/phorge.
#
# Re-running upgrades in place. Only the tracked source is copied, so the
# fonts under webroot/rsrc/font/ survive; they are re-fetched anyway, which is
# what picks up a version bump in bin/fetch-fonts.
#
# Expects to be run as the user the web server runs as, so the installed files
# are readable by the server without any ownership fixup. Any user with write
# access to the Phorge checkout works; see the umask and chmod notes below.
#
# Restart the web server (and phd) afterwards. To uninstall, delete
# $PHORGE_ROOT/src/extensions/phorge-fonts and run `bin/celerity map` again.

set -eu

# Whatever user runs this owns the result, and nothing here changes that: the
# service account is the deployment's choice, not ours. Normally that is the
# user the web server runs as, so it can read the installed files by virtue of
# owning them. To keep a run by any other user working too, force a permissive
# umask and re-assert read/traverse bits at the end instead of chowning.
umask 022

EXTENSION_NAME='phorge-fonts'

SOURCE=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
PHORGE_ROOT=${1:-${PHORGE:-/var/www/phorge/phorge}}

WHOAMI=$(id -un 2>/dev/null || echo "${USER:-unknown}")

if [ ! -d "$PHORGE_ROOT/src/extensions" ]; then
  echo "install: '$PHORGE_ROOT' does not look like a Phorge install" >&2
  echo "(no src/extensions directory). Pass the root as an argument." >&2
  exit 1
fi

if [ ! -x "$PHORGE_ROOT/bin/celerity" ]; then
  echo "install: '$PHORGE_ROOT/bin/celerity' is missing or not executable." >&2
  exit 1
fi

# `bin/celerity map` rewrites the map of every registered resource source, not
# only ours, so it needs to write Phorge's own map as well. Check that up
# front: failing here is far easier to read than failing halfway through the
# rebuild, and it is the permission most likely to be missing when the install
# runs as the web server user rather than as the checkout's owner.
for REQUIRED in \
  "$PHORGE_ROOT/src/extensions" \
  "$PHORGE_ROOT/resources/celerity" \
  "$PHORGE_ROOT/resources/celerity/map.php"; do
  if [ -e "$REQUIRED" ] && [ ! -w "$REQUIRED" ]; then
    echo "install: '$REQUIRED' is not writable by '$WHOAMI'." >&2
    echo "Run as the user that owns the Phorge checkout, or grant write" >&2
    echo "access; 'bin/celerity map' rewrites Phorge's own resource map." >&2
    exit 1
  fi
done

TARGET="$PHORGE_ROOT/src/extensions/$EXTENSION_NAME"

echo "Installing to $TARGET"
echo "Running as $WHOAMI"
mkdir -p "$TARGET"

# Replace the source tree outright rather than copying over it, so a class or
# stylesheet dropped upstream does not linger in the extensions directory and
# keep getting loaded. Only these three paths are touched: the downloaded
# fonts under webroot/rsrc/font/ and the licenses/ directory are left alone.
#
# `resources/celerity/map.php` goes back to the empty placeholder here and is
# regenerated by `bin/celerity map` below, so a half-finished upgrade degrades
# to default fonts rather than serving a map pointing at files that moved.
rm -rf "$TARGET/src" "$TARGET/resources" "$TARGET/webroot/rsrc/css"
mkdir -p "$TARGET/webroot/rsrc"
cp -R "$SOURCE/extension/src" "$TARGET/src"
cp -R "$SOURCE/extension/resources" "$TARGET/resources"
cp -R "$SOURCE/extension/webroot/rsrc/css" "$TARGET/webroot/rsrc/css"

echo
sh "$SOURCE/bin/fetch-fonts" "$TARGET"

# The web server has to read every one of these. `cp` carries the source modes
# over, and the checkout this is copied from may be tighter than the served
# tree needs, so widen read and traverse bits without touching ownership or
# making anything executable that was not already.
chmod -R a+rX "$TARGET"

echo
echo 'Rebuilding the Celerity resource map...'
"$PHORGE_ROOT/bin/celerity" map

echo
echo 'Done. Restart your web server (and phd) to pick up the change.'
